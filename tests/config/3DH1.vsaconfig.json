      "name": "3DH1",
      "symbol_format": "Decimal",
      "symbols": [
        2,
        7,
        2,
        7,
        2,
        7,
        7,
        2,
        2,
        2
      ],
      "threshold_auto": true,
      "threshold_percent": 90.0,
      "meas_only_if_correct": false,
      "allow_inverted_fsk_pattern": false
    },
    "result_range": {

{
  "schema": "pluto-vsa-meas-config",
  "version": 1,
  "settings": {
    "input_frontend": {
      "input_source": "Pluto",
      "pluto_uri": "",
      "center_frequency_mhz": 2441.0,
      "rf_bandwidth_mhz": 8.0,
      "internal_gain_db": 30,
      "external_attenuation_db": 30.0,
      "external_gain_db": 0.0,
      "analysis_channel_enabled": false,
      "analysis_center_mhz": 2441.0,
      "analysis_bandwidth_mhz": 1.5
